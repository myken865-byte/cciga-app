{
  "name": "cciga-app-desktop",
  "productName": "CCIGA App",
  "version": "1.3.4",
  "description": "CCIGA App pour Windows",
  "main": "main.js",
  "private": true,
  "author": "CCIGA",
  "scripts": {
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ht.cciga.app.desktop",
    "productName": "CCIGA App",
    "directories": {
      "output": "dist2"
    },
    "files": [
      "main.js",
      "preload.js",
      "home.html",
      "loading.html",
      "error.html",
      "logo.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "signAndEditExecutable": false,
      "signDlls": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "CCIGA App",
      "artifactName": "CCIGA-App-Setup-v${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
