// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model AdmissionSubmission {
  id          String   @id @default(cuid())
  reference   String   @unique
  submittedAt DateTime @default(now())
  school      String
  programSlug String
  firstName   String
  lastName    String
  dob         String?
  email       String
  phone       String
  address     String?
  documents   String
  status      String   @default("nouveau")
  adminNote   String?
  updatedAt   DateTime @updatedAt

  studentUserId Int?
  student       User? @relation(fields: [studentUserId], references: [id])

  enrollmentForms EnrollmentForm[]
  classicEnrollmentForms ClassicEnrollmentForm[]
}

// Fiche d'inscription du Secrétariat — reconstruction numérique fidèle du
// formulaire papier officiel de l'École Professionnelle. Distincte
// d'AdmissionSubmission (candidature en ligne) : cette fiche est remplie par
// le secrétariat lui-même, souvent pour un candidat déjà admis. N° affiché
// est dérivé de l'id (voir lib/enrollmentFormReference.ts), jamais stocké
// séparément, jamais horodaté — même convention que formatDocumentReference.
model EnrollmentForm {
  id     String @id @default(cuid())
  school String @default("ecole-professionnelle")

  programId String?
  program   Program? @relation(fields: [programId], references: [id])

  status String @default("brouillon") // brouillon | incomplet | a_verifier | validee

  // État civil
  lastName          String
  firstName         String
  birthDateAndPlace String?
  sex               String?
  fatherName        String?
  motherName        String?
  familyStatus      String?
  cin               String?
  cinIssuedDate     String?
  cinIssuedPlace    String?
  address           String?
  phone             String?
  email             String?
  photoUrl          String?

  // Personne à contacter en cas de nécessité
  emergencyContactName  String?
  emergencyContactEmail String?
  emergencyContactPhone String?

  // Pièces fournies — JSON [{label, status, fileUrl, fileName}], statut par
  // pièce parmi fourni | non_fourni | a_verifier (voir lib/enrollmentFormDocuments.ts).
  documents String @default("[]")

  // Déclaration du candidat (page 2)
  declarationAccepted Boolean   @default(false)
  declarationDate     DateTime?

  // Résumé (page 2) — jamais un montant inventé : champs libres remplis
  // manuellement par le secrétariat, jamais pré-remplis automatiquement.
  inscriptionInfo String?
  uniformInfo     String?
  versement1      String?
  versement2      String?
  versement3      String?

  // Pas de double saisie — rattachement à un compte ou une candidature déjà
  // existants pour reprendre leurs informations sans ressaisie.
  studentUserId Int?
  student       User? @relation("EnrollmentFormStudent", fields: [studentUserId], references: [id])

  admissionSubmissionId String?
  admissionSubmission   AdmissionSubmission? @relation(fields: [admissionSubmissionId], references: [id])

  createdById Int?
  createdBy   User? @relation("EnrollmentFormCreatedBy", fields: [createdById], references: [id])
  updatedById Int?
  updatedBy   User? @relation("EnrollmentFormUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
  @@index([school, status])
}

// Fiche d'inscription du Secrétariat — reconstruction numérique fidèle du
// formulaire papier officiel de l'École Classique. Modèle strictement
// distinct d'EnrollmentForm (École Professionnelle) : aucun champ, aucune
// route, aucune donnée partagée entre les deux — isolation stricte entre
// écoles. N° affiché dérivé de l'id (voir lib/classicEnrollmentFormReference.ts),
// jamais stocké séparément, jamais horodaté.
model ClassicEnrollmentForm {
  id     String @id @default(cuid())
  status String @default("brouillon") // brouillon | incomplet | a_verifier | validee

  // Cadre réservé à l'administration
  registrationDate String?
  schoolLevel      String?
  programId        String?
  program          Program? @relation(fields: [programId], references: [id])
  previousSchool   String?
  adminCode        String?
  // Formulaire intelligent — année scolaire sélectionnée depuis les années
  // académiques réellement configurées (voir AcademicYear), jamais une
  // valeur libre. Nullable : ce champ n'existait pas avant cette mission.
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])

  // Renseignements de l'enfant
  lastName          String
  firstName         String
  birthPlaceCity    String?
  birthPlaceDept    String?
  birthDate         String?
  sex               String?
  bloodType         String?
  livesWith         String? // parents | pere | mere | tuteurs
  religion          String?
  addressNumber     String?
  addressStreet     String?
  addressCity       String?
  addressPostalCode String?
  addressZone       String?
  photoUrl          String?

  // Responsables légaux
  familyStatus String? // maries | vie_maritale | veuf | divorces | separes | celibataire

  fatherName       String?
  fatherProfession String?
  fatherOccupation String?
  fatherEmail      String?
  fatherPhone      String?
  fatherNif        String?
  fatherCin        String?

  motherName       String?
  motherProfession String?
  motherOccupation String?
  motherEmail      String?
  motherPhone      String?
  motherNif        String?
  motherCin        String?

  // Personne responsable si différente des parents — facultative par nature.
  guardianName       String?
  guardianProfession String?
  guardianOccupation String?
  guardianEmail      String?
  guardianPhone      String?
  guardianNif        String?
  guardianCin        String?

  // Informations de santé administratives — accès restreint au Secrétariat
  // au même titre que le reste de la fiche, jamais exposé publiquement.
  vaccinesUpToDate   Boolean?
  longTermMedication Boolean?
  medicationDetails  String?

  // Fratrie — JSON [{firstName, birthDate, school}], voir lib/classicEnrollmentSiblings.ts.
  siblings String @default("[]")

  // Certification
  declarationAccepted Boolean   @default(false)
  declarationDate     DateTime?

  // Pas de double saisie — rattachement à un compte ou une candidature déjà existants.
  studentUserId Int?
  student       User? @relation("ClassicEnrollmentFormStudent", fields: [studentUserId], references: [id])

  admissionSubmissionId String?
  admissionSubmission   AdmissionSubmission? @relation(fields: [admissionSubmissionId], references: [id])

  createdById Int?
  createdBy   User? @relation("ClassicEnrollmentFormCreatedBy", fields: [createdById], references: [id])
  updatedById Int?
  updatedBy   User? @relation("ClassicEnrollmentFormUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
  @@index([status])
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  roles        String
  createdAt    DateTime @default(now())

  passwordResetTokenHash String?   @unique
  passwordResetExpires   DateTime?

  // Optionnelle — réutilisée par le gabarit de badge quand elle existe.
  // Aucune photo réelle collectée par défaut ; upload via @vercel/blob (même
  // mécanisme que les pièces jointes du guichet parent et de l'admission).
  photoUrl String?

  // Coordonnées et identité — optionnelles, remplies via le dossier admin ou
  // reprises d'une candidature approuvée. Jamais requises pour ne pas casser
  // les comptes déjà créés avant l'ajout de ces champs.
  dob     DateTime?
  phone   String?
  address String?

  // Archivage au lieu de suppression destructive — un compte archivé ne peut
  // plus se connecter mais son historique (notes, présences, bulletins) reste
  // intact et consultable par l'administration.
  active Boolean @default(true)

  admissionSubmissions AdmissionSubmission[]
  enrollmentFormsAsCandidate EnrollmentForm[] @relation("EnrollmentFormStudent")
  enrollmentFormsCreated     EnrollmentForm[] @relation("EnrollmentFormCreatedBy")
  enrollmentFormsUpdated     EnrollmentForm[] @relation("EnrollmentFormUpdatedBy")

  classicEnrollmentFormsAsCandidate ClassicEnrollmentForm[] @relation("ClassicEnrollmentFormStudent")
  classicEnrollmentFormsCreated     ClassicEnrollmentForm[] @relation("ClassicEnrollmentFormCreatedBy")
  classicEnrollmentFormsUpdated     ClassicEnrollmentForm[] @relation("ClassicEnrollmentFormUpdatedBy")

  programId String?
  program   Program? @relation(fields: [programId], references: [id])

  payments         Payment[] @relation("PaymentStudent")
  paymentsRecorded Payment[] @relation("PaymentRecordedBy")

  coursesTaught Course[]
  grades        Grade[]
  notifications Notification[]
  attendances   Attendance[]

  parentId Int?
  parent   User?  @relation("ParentChildren", fields: [parentId], references: [id])
  children User[] @relation("ParentChildren")

  titulaireOf          Program[]       @relation("ClassTitulaire")
  coordinatedPrograms  Program[]       @relation("ProgramCoordinator")
  deanOfFaculties      Faculty[]       @relation("FacultyDean")
  observationsAuthored Observation[]   @relation("ObservationAuthor")
  observationsAbout    Observation[]   @relation("ObservationStudent")
  parentMessagesSent   ParentMessage[] @relation("ParentMessageSender")
  parentMessagesAbout  ParentMessage[] @relation("ParentMessageStudent")
  gradesEntered        Grade[]         @relation("GradeEnteredBy")
  gradesValidated      Grade[]         @relation("GradeValidatedBy")
  auditLogs            AuditLog[]

  academicDocuments       AcademicDocument[]     @relation("AcademicDocumentStudent")
  documentsGenerated      AcademicDocument[]     @relation("DocumentGeneratedBy")
  appreciationsAbout      StudentAppreciation[]  @relation("AppreciationStudent")
  appreciationsEntered    StudentAppreciation[]  @relation("AppreciationEnteredBy")

  lessonProgress         LessonProgress[]
  submissions            Submission[]
  quizAttempts           QuizAttempt[]      @relation("QuizAttemptStudent")
  quizAttemptsGraded     QuizAttempt[]      @relation("QuizAttemptGradedBy")
  courseAnnouncements    CourseAnnouncement[]

  parentRequestsSent    ParentRequest[]        @relation("ParentRequestParent")
  parentRequestsAbout   ParentRequest[]        @relation("ParentRequestStudent")
  parentRequestMessages ParentRequestMessage[]

  employeeProfile         Employee?              @relation("EmployeeProfile")
  leaveRequestsReviewed   EmployeeLeaveRequest[]  @relation("LeaveReviewedBy")
  badge                   Badge?                 @relation("BadgeOwner")
  badgesIssued            Badge[]                @relation("BadgeIssuedBy")
  infirmaryVisitsAbout    InfirmaryVisit[]        @relation("InfirmaryVisitStudent")
  infirmaryVisitsRecorded InfirmaryVisit[]        @relation("InfirmaryVisitRecordedBy")
  psychosocialCasesAbout  PsychosocialCase[]      @relation("PsychosocialCaseStudent")
  psychosocialCasesOpened PsychosocialCase[]      @relation("PsychosocialCaseOpenedBy")
  psychosocialNotes       PsychosocialNote[]      @relation("PsychosocialNoteAuthor")
  bookLoans               BookLoan[]              @relation("BookLoanBorrower")
  bookLoansRecorded       BookLoan[]              @relation("BookLoanRecordedBy")
  transportAssignments    TransportAssignment[]   @relation("TransportAssignmentStudent")
  canteenReservations     CanteenReservation[]    @relation("CanteenReservationStudent")
  inventoryItemsAssigned  InventoryItem[]         @relation("InventoryAssignedTo")
  enrollmentSnapshotsCaptured EnrollmentSnapshot[] @relation("EnrollmentSnapshotCapturedBy")
}

model Faculty {
  id        String   @id @default(cuid())
  school    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs Program[]

  // Portail Décanat — un doyen préside une faculté ; nullable, non renseigné
  // tant que l'administration ne l'a pas assigné explicitement.
  doyenId Int?
  doyen   User? @relation("FacultyDean", fields: [doyenId], references: [id])

  @@unique([school, name])
}

model AcademicYear {
  id        String   @id @default(cuid())
  label     String   @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  semesters           Semester[]
  academicDocuments   AcademicDocument[]
  enrollmentSnapshots EnrollmentSnapshot[]
  classicEnrollmentForms ClassicEnrollmentForm[]
}

/**
 * Historisation pluriannuelle des effectifs — capture manuelle et explicite
 * (jamais rétroactive) du nombre réel d'élèves/étudiants par programme, liée
 * à l'année académique active au moment de la capture. Une entrée par
 * (année, programme) : une nouvelle capture pour la même année académique
 * met à jour SA PROPRE ligne, elle n'écrase jamais celle d'une autre année.
 */
model EnrollmentSnapshot {
  id             String       @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  programId      String
  program        Program      @relation(fields: [programId], references: [id])
  studentCount   Int
  capturedAt     DateTime     @default(now())
  capturedById   Int?
  capturedBy     User?        @relation("EnrollmentSnapshotCapturedBy", fields: [capturedById], references: [id])

  @@unique([academicYearId, programId])
}

model Semester {
  id             String       @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  name           String
  order          Int          @default(1)
  createdAt      DateTime     @default(now())
  // Institution propriétaire de cette période — fixée à la création depuis le
  // contexte institutionnel actif (l'année académique, elle, reste partagée).
  // Nullable : les périodes créées avant ce champ restent non rattachées.
  school         String?

  courses           Course[]
  academicDocuments AcademicDocument[]
  appreciations     StudentAppreciation[]
}

model Program {
  id                       String    @id @default(cuid())
  slug                     String    @unique
  school                   String
  faculty                  String
  academicFacultyId        String?
  academicFaculty          Faculty?  @relation(fields: [academicFacultyId], references: [id])
  name                     String
  level                    String
  niveau                   String?
  teacherModel             String?
  titulaireId              Int?
  titulaire                User?     @relation("ClassTitulaire", fields: [titulaireId], references: [id])
  // Portail Coordination — distinct du titulaire (École Classique) : un
  // coordonnateur suit un ou plusieurs programmes/filières universitaires.
  // Nullable, jamais renseigné automatiquement.
  coordinatorId            Int?
  coordinator              User?     @relation("ProgramCoordinator", fields: [coordinatorId], references: [id])
  programType              String?
  programStatus            String?
  authorizationRef         String?
  authorizationDate        DateTime?
  authorizationDocumentRef String?
  passingGrade             Int?
  rankingEnabled           Boolean   @default(false)
  skillsTargeted           String?
  practicalWork            String?
  internship               String?
  certification            String?
  duration                 String
  description              String
  admissionConditions      String
  tuitionFee               Int       @default(0)
  active                   Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  students          User[]
  courses           Course[]
  observations      Observation[]
  academicDocuments AcademicDocument[]
  appreciations     StudentAppreciation[]
  enrollmentSnapshots EnrollmentSnapshot[]
  enrollmentForms     EnrollmentForm[]
  classicEnrollmentForms ClassicEnrollmentForm[]
}

model Payment {
  id           String   @id @default(cuid())
  studentId    Int
  student      User     @relation("PaymentStudent", fields: [studentId], references: [id])
  amount       Int
  paidAt       DateTime @default(now())
  note         String?
  recordedById Int?
  recordedBy   User?    @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  // Abstraction fournisseur — préparée pour MonCash/NatCash sans identifiants réels.
  // "manuel" (défaut) préserve le comportement existant à 100% pour toutes les lignes déjà en base.
  provider          String  @default("manuel") // manuel | moncash | natcash
  providerReference String? // référence de transaction retournée par le fournisseur (absent pour "manuel")
  status            String  @default("confirme") // en_attente | confirme | echoue
}

model Course {
  id          String    @id @default(cuid())
  programId   String
  program     Program   @relation(fields: [programId], references: [id])
  name        String
  code        String?
  description String
  teacherId   Int?
  teacher     User?     @relation(fields: [teacherId], references: [id])
  dayOfWeek   Int?
  startTime   String?
  endTime     String?
  semesterId  String?
  semester    Semester? @relation(fields: [semesterId], references: [id])
  credits     Int?
  coefficient Float?
  groupLabel  String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  retakeOfCourseId String?
  retakeOf         Course?  @relation("CourseRetake", fields: [retakeOfCourseId], references: [id])
  retakenBy        Course[] @relation("CourseRetake")

  materials            CourseMaterial[]
  assignments          Assignment[]
  grades               Grade[]
  attendances          Attendance[]
  evaluationCategories EvaluationCategory[]

  lessonModules LessonModule[]
  quizzes       Quiz[]
  announcements CourseAnnouncement[]
}

model EvaluationCategory {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id])
  name          String
  weightPercent Float
  createdAt     DateTime @default(now())

  grades Grade[]
}

model CourseMaterial {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  title     String
  body      String
  createdAt DateTime @default(now())
}

model Assignment {
  id          String    @id @default(cuid())
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id])
  title       String
  description String
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  grades      Grade[]
  submissions Submission[]
}

model Grade {
  id                   String              @id @default(cuid())
  studentId            Int
  student              User                @relation(fields: [studentId], references: [id])
  courseId             String
  course               Course              @relation(fields: [courseId], references: [id])
  assignmentId         String?
  assignment           Assignment?         @relation(fields: [assignmentId], references: [id])
  evaluationCategoryId String?
  evaluationCategory   EvaluationCategory? @relation(fields: [evaluationCategoryId], references: [id])
  score                Float
  comment              String?
  status               String?
  enteredById          Int?
  enteredBy            User?               @relation("GradeEnteredBy", fields: [enteredById], references: [id])
  validatedById        Int?
  validatedBy          User?               @relation("GradeValidatedBy", fields: [validatedById], references: [id])
  publishedAt          DateTime?
  recordedAt           DateTime            @default(now())

  submission Submission?
}

// --- LMS (pilier 3) — Étape 1 : modèles de données uniquement, non branchés ---
// Tout est additif : aucun modèle existant n'est modifié, aucune donnée existante
// n'est touchée. Course/Assignment/Grade/User/AuditLog sont réutilisés tels quels.

model LessonModule {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  title     String
  order     Int      @default(1)
  createdAt DateTime @default(now())

  lessons Lesson[]
}

model Lesson {
  id          String       @id @default(cuid())
  moduleId    String
  module      LessonModule @relation(fields: [moduleId], references: [id])
  title       String
  order       Int          @default(1)
  contentType String // "texte" | "fichier" | "video"
  body        String?
  fileUrl     String?
  videoUrl    String?
  createdAt   DateTime     @default(now())

  progress LessonProgress[]
  quizzes  Quiz[]
}

model LessonProgress {
  id          String   @id @default(cuid())
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id])
  studentId   Int
  student     User     @relation(fields: [studentId], references: [id])
  completedAt DateTime @default(now())

  @@unique([lessonId, studentId])
}

model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  studentId    Int
  student      User       @relation(fields: [studentId], references: [id])
  submittedAt  DateTime   @default(now())
  textContent  String?
  fileUrl      String?
  late         Boolean    @default(false)
  gradeId      String?    @unique
  grade        Grade?     @relation(fields: [gradeId], references: [id])

  @@unique([assignmentId, studentId])
}

model Quiz {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  lessonId    String?
  lesson      Lesson?  @relation(fields: [lessonId], references: [id])
  title       String
  description String?
  isGraded    Boolean  @default(false)
  maxAttempts Int      @default(1)
  createdAt   DateTime @default(now())

  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id            String @id @default(cuid())
  quizId        String
  quiz          Quiz   @relation(fields: [quizId], references: [id])
  type          String // "qcm" | "vrai_faux" | "reponse_courte"
  prompt        String
  options       String? // JSON — tableau de choix pour "qcm"
  correctAnswer String? // JSON — null pour "reponse_courte" (correction manuelle)
  points        Int    @default(1)
  order         Int    @default(1)
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id])
  studentId   Int
  student     User      @relation("QuizAttemptStudent", fields: [studentId], references: [id])
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Float?
  answers     String? // JSON — { questionId: reponse }
  gradedById  Int?
  gradedBy    User?     @relation("QuizAttemptGradedBy", fields: [gradedById], references: [id])
}

model CourseAnnouncement {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  title     String
  body      String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Attendance {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  studentId Int
  student   User     @relation(fields: [studentId], references: [id])
  date      DateTime
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, studentId, date])
}

model News {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  content   String
  category  String
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  date        DateTime
  location    String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  body      String
  status    String   @default("nouveau")
  createdAt DateTime @default(now())
}

model Observation {
  id        String   @id @default(cuid())
  studentId Int
  student   User     @relation("ObservationStudent", fields: [studentId], references: [id])
  authorId  Int
  author    User     @relation("ObservationAuthor", fields: [authorId], references: [id])
  programId String
  program   Program  @relation(fields: [programId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model ParentMessage {
  id        String   @id @default(cuid())
  studentId Int
  student   User     @relation("ParentMessageStudent", fields: [studentId], references: [id])
  senderId  Int
  sender    User     @relation("ParentMessageSender", fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    Int?
  actor      User?    @relation(fields: [actorId], references: [id])
  before     String?
  after      String?
  reason     String?
  createdAt  DateTime @default(now())
}

model AcademicDocument {
  id             String    @id @default(cuid())
  type           String
  studentId      Int
  student        User      @relation("AcademicDocumentStudent", fields: [studentId], references: [id])
  programId      String
  program        Program   @relation(fields: [programId], references: [id])
  semesterId     String?
  semester       Semester? @relation(fields: [semesterId], references: [id])
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  status         String    @default("publie")
  version        Int       @default(1)
  documentGroupKey String

  previousVersionId String?           @unique
  previousVersion   AcademicDocument? @relation("DocumentVersionChain", fields: [previousVersionId], references: [id])
  supersededBy      AcademicDocument? @relation("DocumentVersionChain")

  snapshotData  String
  generatedAt   DateTime  @default(now())
  generatedById Int?
  generatedBy   User?     @relation("DocumentGeneratedBy", fields: [generatedById], references: [id])
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([documentGroupKey])
  @@index([studentId, programId])
}

/**
 * Digital guichet: a parent-initiated request routed to a service
 * (administration/secrétariat/comptabilité/direction pédagogique), tracked
 * through a status workflow, with a threaded reply history.
 */
model ParentRequest {
  id             String   @id @default(cuid())
  studentId      Int
  student        User     @relation("ParentRequestStudent", fields: [studentId], references: [id])
  parentId       Int
  parent         User     @relation("ParentRequestParent", fields: [parentId], references: [id])
  category       String
  service        String
  subject        String
  status         String   @default("envoyee")
  attachmentUrl  String?
  attachmentName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages ParentRequestMessage[]

  @@index([parentId])
  @@index([studentId])
  @@index([service])
  @@index([status])
}

model ParentRequestMessage {
  id        String        @id @default(cuid())
  requestId String
  request   ParentRequest @relation(fields: [requestId], references: [id])
  authorId  Int
  author    User          @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime      @default(now())

  @@index([requestId])
}

model StudentAppreciation {
  id           String   @id @default(cuid())
  studentId    Int
  student      User     @relation("AppreciationStudent", fields: [studentId], references: [id])
  programId    String
  program      Program  @relation(fields: [programId], references: [id])
  semesterId   String
  semester     Semester @relation(fields: [semesterId], references: [id])
  appreciation String?
  conduct      String?
  enteredById  Int?
  enteredBy    User?    @relation("AppreciationEnteredBy", fields: [enteredById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([studentId, semesterId])
}

// ─────────────────────────────────────────────────────────────────────────
// Modules institutionnels complémentaires (DEV/TEST) — tous additifs.
// ─────────────────────────────────────────────────────────────────────────

/** Portail Personnel / RH — un profil employé par membre du personnel. */
model Employee {
  id           String   @id @default(cuid())
  userId       Int      @unique
  user         User     @relation("EmployeeProfile", fields: [userId], references: [id])
  fonction     String
  departement  String
  typeContrat  String // cdi | cdd | vacataire | autre
  dateEntree   DateTime
  statut       String   @default("actif") // actif | conge | suspendu | termine
  horaire      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leaveRequests EmployeeLeaveRequest[]
}

model EmployeeLeaveRequest {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  type         String // conge | absence | retard
  startDate    DateTime
  endDate      DateTime?
  reason       String?
  status       String    @default("soumis") // soumis | approuve | rejete
  reviewedById Int?
  reviewedBy   User?     @relation("LeaveReviewedBy", fields: [reviewedById], references: [id])
  createdAt    DateTime  @default(now())

  @@index([employeeId])
}

/** Contrôle d'accès — un badge par identité (personnel ou apprenant), sans simulation de scan matériel. */
model Badge {
  id          String   @id @default(cuid())
  userId      Int      @unique
  user        User     @relation("BadgeOwner", fields: [userId], references: [id])
  badgeNumber String   @unique
  status      String   @default("actif") // actif | perdu | remplace | inactif
  issuedAt    DateTime @default(now())
  issuedById  Int?
  issuedBy    User?    @relation("BadgeIssuedBy", fields: [issuedById], references: [id])
}

/** Infirmerie — registre des passages, accès limité au personnel autorisé. */
model InfirmaryVisit {
  id                String   @id @default(cuid())
  studentId         Int
  student           User     @relation("InfirmaryVisitStudent", fields: [studentId], references: [id])
  visitDate         DateTime @default(now())
  category          String
  observations      String?
  contactedGuardian Boolean  @default(false)
  recordedById      Int
  recordedBy        User     @relation("InfirmaryVisitRecordedBy", fields: [recordedById], references: [id])
  createdAt         DateTime @default(now())

  @@index([studentId])
}

/** Suivi psychosocial — dossier protégé, accès strictement restreint. */
model PsychosocialCase {
  id         String   @id @default(cuid())
  studentId  Int
  student    User     @relation("PsychosocialCaseStudent", fields: [studentId], references: [id])
  status     String   @default("ouvert") // ouvert | suivi | cloture
  openedById Int
  openedBy   User     @relation("PsychosocialCaseOpenedBy", fields: [openedById], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  notes      PsychosocialNote[]

  @@index([studentId])
}

model PsychosocialNote {
  id       String           @id @default(cuid())
  caseId   String
  case     PsychosocialCase @relation(fields: [caseId], references: [id])
  body     String
  authorId Int
  author   User             @relation("PsychosocialNoteAuthor", fields: [authorId], references: [id])
  createdAt DateTime        @default(now())

  @@index([caseId])
}

/** Bibliothèque — catalogue et emprunts. */
model Book {
  id          String   @id @default(cuid())
  title       String
  author      String
  category    String
  isbn        String?
  totalCopies Int      @default(1)
  createdAt   DateTime @default(now())

  loans       BookLoan[]
}

model BookLoan {
  id           String    @id @default(cuid())
  bookId       String
  book         Book      @relation(fields: [bookId], references: [id])
  borrowerId   Int
  borrower     User      @relation("BookLoanBorrower", fields: [borrowerId], references: [id])
  borrowedAt   DateTime  @default(now())
  dueDate      DateTime
  returnedAt   DateTime?
  recordedById Int?
  recordedBy   User?     @relation("BookLoanRecordedBy", fields: [recordedById], references: [id])

  @@index([bookId])
  @@index([borrowerId])
}

/** Transport — véhicules et affectations, sans données institutionnelles inventées. */
model Vehicle {
  id       String   @id @default(cuid())
  label    String
  plate    String?
  capacity Int?
  status   String   @default("actif")
  driverName String?
  schedule String?

  assignments TransportAssignment[]
}

model TransportAssignment {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  studentId Int
  student   User     @relation("TransportAssignmentStudent", fields: [studentId], references: [id])
  createdAt DateTime @default(now())

  @@index([vehicleId])
  @@index([studentId])
}

/** Cantine — menus et réservations. */
model CanteenMenu {
  id          String   @id @default(cuid())
  date        DateTime
  label       String
  description String?
  createdAt   DateTime @default(now())

  reservations CanteenReservation[]
}

model CanteenReservation {
  id        String   @id @default(cuid())
  menuId    String
  menu      CanteenMenu @relation(fields: [menuId], references: [id])
  studentId Int
  student   User     @relation("CanteenReservationStudent", fields: [studentId], references: [id])
  status    String   @default("reserve") // reserve | servi | annule
  createdAt DateTime @default(now())

  @@index([menuId])
  @@index([studentId])
}

/** Inventaire / Patrimoine. */
model InventoryItem {
  id           String   @id @default(cuid())
  // Cloisonnement strict par institution (portail Logistique) — jamais de
  // fuite d'inventaire entre École Classique, École Professionnelle et Université.
  school       String // ecole-classique | ecole-professionnelle | universite
  name         String
  category     String // equipement | mobilier | informatique | pedagogique | laboratoire
  identifier   String?  @unique
  location     String?
  condition    String   @default("bon") // bon | moyen | mauvais | hors_service
  quantity     Int      @default(1)
  assignedToId Int?
  assignedTo   User?    @relation("InventoryAssignedTo", fields: [assignedToId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([school])
}
