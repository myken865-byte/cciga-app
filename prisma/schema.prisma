// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model AdmissionSubmission {
  id          String   @id @default(cuid())
  reference   String   @unique
  submittedAt DateTime @default(now())
  school      String
  programSlug String
  firstName   String
  lastName    String
  dob         String?
  email       String
  phone       String
  address     String?
  documents   String
  status      String   @default("nouveau")
  adminNote   String?
  updatedAt   DateTime @updatedAt

  studentUserId Int?
  student       User? @relation(fields: [studentUserId], references: [id])
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  roles        String
  createdAt    DateTime @default(now())

  passwordResetTokenHash String?   @unique
  passwordResetExpires   DateTime?

  admissionSubmissions AdmissionSubmission[]

  programId String?
  program   Program? @relation(fields: [programId], references: [id])

  payments         Payment[] @relation("PaymentStudent")
  paymentsRecorded Payment[] @relation("PaymentRecordedBy")

  coursesTaught Course[]
  grades        Grade[]
  notifications Notification[]
  attendances   Attendance[]

  parentId Int?
  parent   User?  @relation("ParentChildren", fields: [parentId], references: [id])
  children User[] @relation("ParentChildren")

  titulaireOf          Program[]       @relation("ClassTitulaire")
  observationsAuthored Observation[]   @relation("ObservationAuthor")
  observationsAbout    Observation[]   @relation("ObservationStudent")
  parentMessagesSent   ParentMessage[] @relation("ParentMessageSender")
  parentMessagesAbout  ParentMessage[] @relation("ParentMessageStudent")
  gradesEntered        Grade[]         @relation("GradeEnteredBy")
  gradesValidated      Grade[]         @relation("GradeValidatedBy")
  auditLogs            AuditLog[]

  academicDocuments       AcademicDocument[]     @relation("AcademicDocumentStudent")
  documentsGenerated      AcademicDocument[]     @relation("DocumentGeneratedBy")
  appreciationsAbout      StudentAppreciation[]  @relation("AppreciationStudent")
  appreciationsEntered    StudentAppreciation[]  @relation("AppreciationEnteredBy")

  lessonProgress         LessonProgress[]
  submissions            Submission[]
  quizAttempts           QuizAttempt[]      @relation("QuizAttemptStudent")
  quizAttemptsGraded     QuizAttempt[]      @relation("QuizAttemptGradedBy")
  courseAnnouncements    CourseAnnouncement[]
}

model Faculty {
  id        String   @id @default(cuid())
  school    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs Program[]

  @@unique([school, name])
}

model AcademicYear {
  id        String   @id @default(cuid())
  label     String   @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  semesters         Semester[]
  academicDocuments AcademicDocument[]
}

model Semester {
  id             String       @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  name           String
  order          Int          @default(1)
  createdAt      DateTime     @default(now())

  courses           Course[]
  academicDocuments AcademicDocument[]
  appreciations     StudentAppreciation[]
}

model Program {
  id                       String    @id @default(cuid())
  slug                     String    @unique
  school                   String
  faculty                  String
  academicFacultyId        String?
  academicFaculty          Faculty?  @relation(fields: [academicFacultyId], references: [id])
  name                     String
  level                    String
  niveau                   String?
  teacherModel             String?
  titulaireId              Int?
  titulaire                User?     @relation("ClassTitulaire", fields: [titulaireId], references: [id])
  programType              String?
  programStatus            String?
  authorizationRef         String?
  authorizationDate        DateTime?
  authorizationDocumentRef String?
  passingGrade             Int?
  rankingEnabled           Boolean   @default(false)
  skillsTargeted           String?
  practicalWork            String?
  internship               String?
  certification            String?
  duration                 String
  description              String
  admissionConditions      String
  tuitionFee               Int       @default(0)
  active                   Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  students          User[]
  courses           Course[]
  observations      Observation[]
  academicDocuments AcademicDocument[]
  appreciations     StudentAppreciation[]
}

model Payment {
  id           String   @id @default(cuid())
  studentId    Int
  student      User     @relation("PaymentStudent", fields: [studentId], references: [id])
  amount       Int
  paidAt       DateTime @default(now())
  note         String?
  recordedById Int?
  recordedBy   User?    @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
}

model Course {
  id          String    @id @default(cuid())
  programId   String
  program     Program   @relation(fields: [programId], references: [id])
  name        String
  code        String?
  description String
  teacherId   Int?
  teacher     User?     @relation(fields: [teacherId], references: [id])
  dayOfWeek   Int?
  startTime   String?
  endTime     String?
  semesterId  String?
  semester    Semester? @relation(fields: [semesterId], references: [id])
  credits     Int?
  coefficient Float?
  groupLabel  String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  retakeOfCourseId String?
  retakeOf         Course?  @relation("CourseRetake", fields: [retakeOfCourseId], references: [id])
  retakenBy        Course[] @relation("CourseRetake")

  materials            CourseMaterial[]
  assignments          Assignment[]
  grades               Grade[]
  attendances          Attendance[]
  evaluationCategories EvaluationCategory[]

  lessonModules LessonModule[]
  quizzes       Quiz[]
  announcements CourseAnnouncement[]
}

model EvaluationCategory {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id])
  name          String
  weightPercent Float
  createdAt     DateTime @default(now())

  grades Grade[]
}

model CourseMaterial {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  title     String
  body      String
  createdAt DateTime @default(now())
}

model Assignment {
  id          String    @id @default(cuid())
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id])
  title       String
  description String
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  grades      Grade[]
  submissions Submission[]
}

model Grade {
  id                   String              @id @default(cuid())
  studentId            Int
  student              User                @relation(fields: [studentId], references: [id])
  courseId             String
  course               Course              @relation(fields: [courseId], references: [id])
  assignmentId         String?
  assignment           Assignment?         @relation(fields: [assignmentId], references: [id])
  evaluationCategoryId String?
  evaluationCategory   EvaluationCategory? @relation(fields: [evaluationCategoryId], references: [id])
  score                Float
  comment              String?
  status               String?
  enteredById          Int?
  enteredBy            User?               @relation("GradeEnteredBy", fields: [enteredById], references: [id])
  validatedById        Int?
  validatedBy          User?               @relation("GradeValidatedBy", fields: [validatedById], references: [id])
  publishedAt          DateTime?
  recordedAt           DateTime            @default(now())

  submission Submission?
}

// --- LMS (pilier 3) — Étape 1 : modèles de données uniquement, non branchés ---
// Tout est additif : aucun modèle existant n'est modifié, aucune donnée existante
// n'est touchée. Course/Assignment/Grade/User/AuditLog sont réutilisés tels quels.

model LessonModule {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  title     String
  order     Int      @default(1)
  createdAt DateTime @default(now())

  lessons Lesson[]
}

model Lesson {
  id          String       @id @default(cuid())
  moduleId    String
  module      LessonModule @relation(fields: [moduleId], references: [id])
  title       String
  order       Int          @default(1)
  contentType String // "texte" | "fichier" | "video"
  body        String?
  fileUrl     String?
  videoUrl    String?
  createdAt   DateTime     @default(now())

  progress LessonProgress[]
  quizzes  Quiz[]
}

model LessonProgress {
  id          String   @id @default(cuid())
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id])
  studentId   Int
  student     User     @relation(fields: [studentId], references: [id])
  completedAt DateTime @default(now())

  @@unique([lessonId, studentId])
}

model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  studentId    Int
  student      User       @relation(fields: [studentId], references: [id])
  submittedAt  DateTime   @default(now())
  textContent  String?
  fileUrl      String?
  late         Boolean    @default(false)
  gradeId      String?    @unique
  grade        Grade?     @relation(fields: [gradeId], references: [id])

  @@unique([assignmentId, studentId])
}

model Quiz {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  lessonId    String?
  lesson      Lesson?  @relation(fields: [lessonId], references: [id])
  title       String
  description String?
  isGraded    Boolean  @default(false)
  maxAttempts Int      @default(1)
  createdAt   DateTime @default(now())

  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id            String @id @default(cuid())
  quizId        String
  quiz          Quiz   @relation(fields: [quizId], references: [id])
  type          String // "qcm" | "vrai_faux" | "reponse_courte"
  prompt        String
  options       String? // JSON — tableau de choix pour "qcm"
  correctAnswer String? // JSON — null pour "reponse_courte" (correction manuelle)
  points        Int    @default(1)
  order         Int    @default(1)
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id])
  studentId   Int
  student     User      @relation("QuizAttemptStudent", fields: [studentId], references: [id])
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Float?
  answers     String? // JSON — { questionId: reponse }
  gradedById  Int?
  gradedBy    User?     @relation("QuizAttemptGradedBy", fields: [gradedById], references: [id])
}

model CourseAnnouncement {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  title     String
  body      String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Attendance {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  studentId Int
  student   User     @relation(fields: [studentId], references: [id])
  date      DateTime
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, studentId, date])
}

model News {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  content   String
  category  String
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  date        DateTime
  location    String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  body      String
  status    String   @default("nouveau")
  createdAt DateTime @default(now())
}

model Observation {
  id        String   @id @default(cuid())
  studentId Int
  student   User     @relation("ObservationStudent", fields: [studentId], references: [id])
  authorId  Int
  author    User     @relation("ObservationAuthor", fields: [authorId], references: [id])
  programId String
  program   Program  @relation(fields: [programId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model ParentMessage {
  id        String   @id @default(cuid())
  studentId Int
  student   User     @relation("ParentMessageStudent", fields: [studentId], references: [id])
  senderId  Int
  sender    User     @relation("ParentMessageSender", fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    Int?
  actor      User?    @relation(fields: [actorId], references: [id])
  before     String?
  after      String?
  reason     String?
  createdAt  DateTime @default(now())
}

model AcademicDocument {
  id             String    @id @default(cuid())
  type           String
  studentId      Int
  student        User      @relation("AcademicDocumentStudent", fields: [studentId], references: [id])
  programId      String
  program        Program   @relation(fields: [programId], references: [id])
  semesterId     String?
  semester       Semester? @relation(fields: [semesterId], references: [id])
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  status         String    @default("publie")
  version        Int       @default(1)
  documentGroupKey String

  previousVersionId String?           @unique
  previousVersion   AcademicDocument? @relation("DocumentVersionChain", fields: [previousVersionId], references: [id])
  supersededBy      AcademicDocument? @relation("DocumentVersionChain")

  snapshotData  String
  generatedAt   DateTime  @default(now())
  generatedById Int?
  generatedBy   User?     @relation("DocumentGeneratedBy", fields: [generatedById], references: [id])
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([documentGroupKey])
  @@index([studentId, programId])
}

model StudentAppreciation {
  id           String   @id @default(cuid())
  studentId    Int
  student      User     @relation("AppreciationStudent", fields: [studentId], references: [id])
  programId    String
  program      Program  @relation(fields: [programId], references: [id])
  semesterId   String
  semester     Semester @relation(fields: [semesterId], references: [id])
  appreciation String?
  conduct      String?
  enteredById  Int?
  enteredBy    User?    @relation("AppreciationEnteredBy", fields: [enteredById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([studentId, semesterId])
}
