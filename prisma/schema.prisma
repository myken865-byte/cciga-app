// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model AdmissionSubmission {
  id            String   @id @default(cuid())
  reference     String   @unique
  submittedAt   DateTime @default(now())
  school        String
  programSlug   String
  firstName     String
  lastName      String
  dob           String?
  email         String
  phone         String
  address       String?
  documents     String
  status        String   @default("nouveau")
  adminNote     String?
  updatedAt     DateTime @updatedAt

  studentUserId Int?
  student       User?    @relation(fields: [studentUserId], references: [id])
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  roles        String
  createdAt    DateTime @default(now())

  admissionSubmissions AdmissionSubmission[]

  programId String?
  program   Program? @relation(fields: [programId], references: [id])

  payments Payment[]

  coursesTaught Course[]
  grades        Grade[]
  notifications Notification[]
  attendances   Attendance[]

  parentId Int?
  parent   User?  @relation("ParentChildren", fields: [parentId], references: [id])
  children User[] @relation("ParentChildren")

  titulaireOf          Program[]       @relation("ClassTitulaire")
  observationsAuthored Observation[]   @relation("ObservationAuthor")
  observationsAbout    Observation[]   @relation("ObservationStudent")
  parentMessagesSent   ParentMessage[] @relation("ParentMessageSender")
  parentMessagesAbout  ParentMessage[] @relation("ParentMessageStudent")
  gradesEntered        Grade[]         @relation("GradeEnteredBy")
  gradesValidated      Grade[]         @relation("GradeValidatedBy")
  auditLogs            AuditLog[]
}

model Faculty {
  id        String   @id @default(cuid())
  school    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs Program[]

  @@unique([school, name])
}

model AcademicYear {
  id        String   @id @default(cuid())
  label     String   @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  semesters Semester[]
}

model Semester {
  id             String       @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  name           String
  order          Int          @default(1)
  createdAt      DateTime     @default(now())

  courses Course[]
}

model Program {
  id                       String    @id @default(cuid())
  slug                     String    @unique
  school                   String
  faculty                  String
  academicFacultyId        String?
  academicFaculty          Faculty?  @relation(fields: [academicFacultyId], references: [id])
  name                     String
  level                    String
  niveau                   String?
  teacherModel             String?
  titulaireId              Int?
  titulaire                User?     @relation("ClassTitulaire", fields: [titulaireId], references: [id])
  programType              String?
  programStatus            String?
  authorizationRef         String?
  authorizationDate        DateTime?
  authorizationDocumentRef String?
  passingGrade             Int?
  duration                 String
  description              String
  admissionConditions      String
  tuitionFee               Int       @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  students     User[]
  courses      Course[]
  observations Observation[]
}

model Payment {
  id        String   @id @default(cuid())
  studentId Int
  student   User     @relation(fields: [studentId], references: [id])
  amount    Int
  paidAt    DateTime @default(now())
  note      String?
}

model Course {
  id          String    @id @default(cuid())
  programId   String
  program     Program   @relation(fields: [programId], references: [id])
  name        String
  code        String?
  description String
  teacherId   Int?
  teacher     User?     @relation(fields: [teacherId], references: [id])
  dayOfWeek   Int?
  startTime   String?
  endTime     String?
  semesterId  String?
  semester    Semester? @relation(fields: [semesterId], references: [id])
  credits     Int?
  coefficient Float?
  groupLabel  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  materials            CourseMaterial[]
  assignments          Assignment[]
  grades               Grade[]
  attendances          Attendance[]
  evaluationCategories EvaluationCategory[]
}

model EvaluationCategory {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id])
  name          String
  weightPercent Float
  createdAt     DateTime @default(now())

  grades Grade[]
}

model CourseMaterial {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  title     String
  body      String
  createdAt DateTime @default(now())
}

model Assignment {
  id          String    @id @default(cuid())
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id])
  title       String
  description String
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  grades Grade[]
}

model Grade {
  id                    String              @id @default(cuid())
  studentId             Int
  student               User                @relation(fields: [studentId], references: [id])
  courseId              String
  course                Course              @relation(fields: [courseId], references: [id])
  assignmentId          String?
  assignment            Assignment?         @relation(fields: [assignmentId], references: [id])
  evaluationCategoryId  String?
  evaluationCategory    EvaluationCategory? @relation(fields: [evaluationCategoryId], references: [id])
  score                 Float
  comment               String?
  status                String?
  enteredById           Int?
  enteredBy             User?               @relation("GradeEnteredBy", fields: [enteredById], references: [id])
  validatedById         Int?
  validatedBy           User?               @relation("GradeValidatedBy", fields: [validatedById], references: [id])
  publishedAt           DateTime?
  recordedAt            DateTime            @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Attendance {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  studentId Int
  student   User     @relation(fields: [studentId], references: [id])
  date      DateTime
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, studentId, date])
}

model News {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  content   String
  category  String
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  date        DateTime
  location    String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  body      String
  status    String   @default("nouveau")
  createdAt DateTime @default(now())
}

model Observation {
  id        String   @id @default(cuid())
  studentId Int
  student   User     @relation("ObservationStudent", fields: [studentId], references: [id])
  authorId  Int
  author    User     @relation("ObservationAuthor", fields: [authorId], references: [id])
  programId String
  program   Program  @relation(fields: [programId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model ParentMessage {
  id        String   @id @default(cuid())
  studentId Int
  student   User     @relation("ParentMessageStudent", fields: [studentId], references: [id])
  senderId  Int
  sender    User     @relation("ParentMessageSender", fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    Int?
  actor      User?    @relation(fields: [actorId], references: [id])
  before     String?
  after      String?
  reason     String?
  createdAt  DateTime @default(now())
}
